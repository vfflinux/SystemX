# ============================================================
# SystemX — Modelo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha as credenciais.
# ============================================================
PORT=8080

# Conta Administrador (acesso total)
ADMIN_NOME=Administrador
ADMIN_EMAIL=administrador@exemplo.com
ADMIN_SENHA=troque_esta_senha_admin

# Conta Funcionário (operações da biblioteca)
FUNCIONARIO_NOME=Funcionário
FUNCIONARIO_EMAIL=funcionario@exemplo.com
FUNCIONARIO_SENHA=troque_esta_senha_func

# Conta Somente Visualização (somente leitura)
VISUALIZADOR_NOME=Visitante (Visualização)
VISUALIZADOR_EMAIL=visualizador@exemplo.com
VISUALIZADOR_SENHA=troque_esta_senha_vis
